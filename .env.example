# GEMINI_API_KEY: Required for Gemini AI API calls (injected by AI Studio)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# GXQ Network V3.0.0 Multi-Environment Switch
# Refer to specific environment templates:
#   - .env.example.local
#   - .env.example.devnet
#   - .env.example.testnet
#   - .env.example.mainnet
GXQ_NETWORK=devnet
ADMIN_EMAIL="gxqstudio@gmail.com"
